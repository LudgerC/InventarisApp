@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-pc-display" style="font-size: 5rem; color: #7b2f5f;"></i>
    </div>
    <h1 class="display-5 fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #7b2f5f;">Welkom bij InventarisApp</h1>
    <p class="mb-5" style="font-size: 1.1rem; max-width: 500px; margin-left: auto; margin-right: auto; color: #666;">
        Beheer en bekijk alle devices, wifi-adapters en locaties vanuit één overzicht.
    </p>
    <a asp-controller="Device" asp-action="Index" class="btn btn-primary px-5 py-2" style="font-size: 1.1rem;">
        <i class="bi bi-laptop me-2"></i>Bekijk Devices
    </a>
</div>
