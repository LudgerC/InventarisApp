<!DOCTYPE html>
<html lang="nl-be">
<head>
    <!-- Meta data -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Inventaris applicatie" />
    <title>@ViewData["Title"] - InventarisApp</title>

    <!-- Google Fonts: Inter + Outfit (same as KalenderApp) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventarisApp.styles.css" asp-append-version="true" />
    
    <style>
        /* Choices.js UI Fixes */
        .choices__input {
            width: 100% !important;
            background-color: transparent !important;
            font-size: 0.9rem !important;
            padding: 4px 8px !important;
        }
        
        .choices__inner {
            min-height: 45px !important;
            border: 1px solid #dee2e6 !important;
            border-radius: 0.5rem !important;
            background-color: #fff !important;
            display: flex !important;
            align-items: center !important;
        }

        .choices__list--dropdown .choices__input {
            border: 1px solid #eee !important;
            border-radius: 4px !important;
            margin: 5px !important;
            width: calc(100% - 10px) !important;
        }

        .choices__list--single {
            padding: 0 16px 0 4px !important;
        }
    </style>
</head>
<body>
    <header>
        <nav id="headernav" class="navbar navbar-expand-lg py-2">
            <div class="container-fluid px-4">

                <!-- Logo + naam (zoals KalenderApp) -->
                <a class="navbar-brand d-flex align-items-center me-0" asp-controller="Home" asp-action="Index">
                    <img src="/images/logo.png" class="brand-logo me-2" alt="CVO Lethas Logo" style="width: 40px; height: auto;">
                    <span class="fw-bold brand-naam">InventarisApp</span>
                </a>

                <!-- Toggler -->
                <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Navigatie wisselen">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menu -->
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-4">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @((string?)ViewData["Title"] == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Lokaal" ? "active" : "")"
                                   asp-controller="Lokaal" asp-action="Index">
                                    Lokalen
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @((string?)ViewData["Title"] == "Devices" ? "active" : "")"
                                   asp-controller="Device" asp-action="Index">
                                    Apparaten
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Lening" ? "active" : "")"
                                   asp-controller="Lening" asp-action="Index">
                                    Leningen
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @((string?)ViewData["Title"] == "Gebruikers" ? "active" : "")" 
                                       asp-controller="User" asp-action="Index">
                                        Gebruikers
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Rechts: user/login -->
                    <div class="ms-auto d-flex align-items-center gap-3">

                        <ul class="navbar-nav">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                        @User.Identity.Name
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="nav-link btn btn-link p-0 border-0">
                                            Afmelden
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Login">
                                        Aanmelden
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main id="maintext" role="main" class="fade-in">
        @{
            string containerClass = (ViewData["ContainerClass"] as string) ?? "container";
        }
        <div class="@containerClass py-5">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger mb-4" role="alert">
                    @ViewBag.Message
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <!-- Footer (CVO Lethas style: purple + green) -->
    <footer class="site-footer">
        <div class="footer-purple">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <h5><i class="bi bi-pc-display me-2"></i>InventarisApp</h5>
                        <p class="mb-0" style="opacity: 0.85;">Beheer en bekijk alle devices, wifi-adapters en locaties vanuit één overzicht.</p>
                    </div>
                    <div class="col-md-6 text-md-end d-flex flex-column justify-content-center">
                        <p class="mb-0" style="opacity: 0.85;">
                            <a href="https://www.cvolethas.be/" target="_blank" class="text-decoration-none text-light">
                                <i class="bi bi-building me-1"></i>CVO Lethas
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-green">
            <div class="container text-center">
                &copy; @DateTime.Now.Year InventarisApp — 
                <a href="https://www.cvolethas.be/" target="_blank" class="text-decoration-none">
                    CVO Lethas
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @RenderSection("Modals", required: false)
</body>
</html>
