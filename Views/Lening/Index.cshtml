@model IEnumerable<InventarisApp.Models.Lening>

@{
    ViewData["Title"] = "Uitleningen Overzicht";
    ViewData["ContainerClass"] = "container-fluid";
}

<div class="mt-4" style="max-width: 95%; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-gradient" style="font-family: 'Outfit', sans-serif;">Beheer Leningen</h2>
        <div>
            <a asp-controller="Persoon" asp-action="Index" class="btn btn-outline-secondary me-2 shadow-sm">
                <i class="bi bi-people me-1"></i> Personen Beheren
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Nieuwe Lening Toevoegen
            </a>
        </div>
    </div>

    <!-- Filters en Sorteren -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light rounded">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold"><i class="bi bi-search me-1"></i> Zoeken</label>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Persoon, Apparaat, ID...">
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-bold"><i class="bi bi-activity me-1"></i> Status</label>
                    <select name="statusFilter" class="form-select">
                        <option value="">Alle statussen</option>
                        @if (ViewData["CurrentStatus"]?.ToString() == "Active") { <option value="Active" selected="selected">Actief</option> } else { <option value="Active">Actief</option> }
                        @if (ViewData["CurrentStatus"]?.ToString() == "Afgerond") { <option value="Afgerond" selected="selected">Afgerond</option> } else { <option value="Afgerond">Afgerond</option> }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-filter"></i> Toepassen
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Filters wissen">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["IdSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-statusFilter="@ViewData["CurrentStatus"]" class="text-white text-decoration-none d-flex align-items-center">
                            Lening ID
                            @if (string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString())) { <i class="bi bi-sort-numeric-down ms-1"></i> }
                            else if (ViewData["CurrentSort"]?.ToString() == "id_desc") { <i class="bi bi-sort-numeric-up ms-1"></i> }
                            else { <i class="bi bi-arrow-down-up ms-1 text-white-50" style="font-size: 0.8em;"></i> }
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["PersoonSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-statusFilter="@ViewData["CurrentStatus"]" class="text-white text-decoration-none d-flex align-items-center">
                            Persoon
                            @if (ViewData["CurrentSort"]?.ToString() == "persoon_asc") { <i class="bi bi-sort-alpha-down ms-1"></i> }
                            else if (ViewData["CurrentSort"]?.ToString() == "persoon_desc") { <i class="bi bi-sort-alpha-up ms-1"></i> }
                            else { <i class="bi bi-arrow-down-up ms-1 text-white-50" style="font-size: 0.8em;"></i> }
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["ApparaatSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-statusFilter="@ViewData["CurrentStatus"]" class="text-white text-decoration-none d-flex align-items-center">
                            Apparaat
                            @if (ViewData["CurrentSort"]?.ToString() == "apparaat_asc") { <i class="bi bi-sort-alpha-down ms-1"></i> }
                            else if (ViewData["CurrentSort"]?.ToString() == "apparaat_desc") { <i class="bi bi-sort-alpha-up ms-1"></i> }
                            else { <i class="bi bi-arrow-down-up ms-1 text-white-50" style="font-size: 0.8em;"></i> }
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["StartSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-statusFilter="@ViewData["CurrentStatus"]" class="text-white text-decoration-none d-flex align-items-center">
                            Startdatum
                            @if (ViewData["CurrentSort"]?.ToString() == "start_asc") { <i class="bi bi-sort-numeric-down ms-1"></i> }
                            else if (ViewData["CurrentSort"]?.ToString() == "start_desc") { <i class="bi bi-sort-numeric-up ms-1"></i> }
                            else { <i class="bi bi-arrow-down-up ms-1 text-white-50" style="font-size: 0.8em;"></i> }
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["EindSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-statusFilter="@ViewData["CurrentStatus"]" class="text-white text-decoration-none d-flex align-items-center">
                            Einddatum
                            @if (ViewData["CurrentSort"]?.ToString() == "eind_asc") { <i class="bi bi-sort-numeric-down ms-1"></i> }
                            else if (ViewData["CurrentSort"]?.ToString() == "eind_desc") { <i class="bi bi-sort-numeric-up ms-1"></i> }
                            else { <i class="bi bi-arrow-down-up ms-1 text-white-50" style="font-size: 0.8em;"></i> }
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["StatusSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-statusFilter="@ViewData["CurrentStatus"]" class="text-white text-decoration-none d-flex align-items-center">
                            Status
                            @if (ViewData["CurrentSort"]?.ToString() == "status_asc") { <i class="bi bi-sort-down ms-1"></i> }
                            else if (ViewData["CurrentSort"]?.ToString() == "status_desc") { <i class="bi bi-sort-up ms-1"></i> }
                            else { <i class="bi bi-arrow-down-up ms-1 text-white-50" style="font-size: 0.8em;"></i> }
                        </a>
                    </th>
                    <th class="text-center">Acties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    bool isAfgerond = item.einddatum.HasValue && item.einddatum.Value.Date <= DateTime.Now.Date;
                    
                    <tr>
                        <td class="fw-bold">@item.ID</td>
                        <td>
                            @if(item.Persoon != null)
                            {
                                <span>@item.Persoon.Naam @item.Persoon.Achternaam</span>
                            }
                            else
                            {
                                <span class="text-muted">Onbekend</span>
                            }
                        </td>
                        <td>
                            @if(item.Device != null)
                            {
                                var infoType = item.Device.type;
                                var infoName = item.Device.Infos?.FirstOrDefault()?.apparaatnaam ?? (item.Device.Infos?.FirstOrDefault()?.merk + " " + item.Device.Infos?.FirstOrDefault()?.model);
                                <span>[@infoType] @infoName</span>
                            }
                            else
                            {
                                <span class="text-muted">Onbekend</span>
                            }
                        </td>
                        <td>@item.startdatum.ToString("dd/MM/yyyy")</td>
                        <td>@(item.einddatum?.ToString("dd/MM/yyyy") ?? "NVT")</td>
                        <td>
                            @if(isAfgerond)
                            {
                                <span class="badge bg-secondary text-white">Afgerond</span>
                            }
                            else
                            {
                                <span class="badge bg-success text-white">Actief</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-info" title="Details zien">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-outline-secondary" title="Aanpassen">
                                    <i class="bi bi-pencil"></i> Bewerken
                                </a>
                                @if(!isAfgerond)
                                {
                                    <form asp-action="Retourneer" asp-route-id="@item.ID" method="post" class="d-inline ms-1">
                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Retourneren (Stop lenen)" onclick="return confirm('Weet u zeker dat dit apparaat geretourneerd is?');">
                                            <i class="bi bi-arrow-return-left"></i> Retour
                                        </button>
                                    </form>
                                }
                                <button type="button" class="btn btn-sm btn-outline-danger delete-btn ms-1" 
                                        data-action="@Url.Action("Delete", "Lening", new { id = item.ID })"
                                        title="Verwijderen">
                                    <i class="bi bi-trash"></i> Verwijderen
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                
                @if(!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 bg-light text-muted">Geen leningen geregistreerd in het systeem.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Modals {
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-exclamation-triangle-fill text-danger mb-3" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mb-3">Bevestig Verwijdering</h5>
                <p class="text-muted small">Weet je zeker dat je deze lening volledig & permanent uit de database wilt verwijderen?</p>
                
                <form id="globalDeleteForm" method="post">
                    @Html.AntiForgeryToken()
                </form>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger px-4 shadow-sm">Verwijderen</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const deleteModalEl = document.getElementById('deleteConfirmModal');
            const deleteModal = new bootstrap.Modal(deleteModalEl);
            const deleteForm = document.getElementById('globalDeleteForm');
            const confirmBtn = document.getElementById('confirmDeleteBtn');

            document.querySelectorAll('.delete-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const action = this.getAttribute('data-action');
                    deleteForm.setAttribute('action', action);
                    deleteModal.show();
                });
            });

            confirmBtn.addEventListener('click', function() {
                deleteForm.submit();
            });
        });
    </script>
}
